---
interface Props {
  name: 'menu' | 'close' | 'chevron' | 'star' | 'whatsapp';
  class?: string;
  filled?: boolean;
}

const { name, class: className = 'size-5', filled = false } = Astro.props;

const paths = {
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  star: '<path d="m12 3.2 2.3 4.7 5.2.8-3.8 3.6.9 5.2L12 15.8 7.4 17.5l.9-5.2L4.5 8.7l5.2-.8L12 3.2z"/>',
} as const;
---

{
  name === 'whatsapp' ? (
    <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
      <path
        fill="currentColor"
        d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.41a10 10 0 0 0 4.65 1.18h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.76 14.05c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.81-.11-.42-.14-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.15-1.53-1.15-2.92s.73-2.07 1-2.35c.24-.28.64-.41 1.02-.41h.37c.24 0 .36.01.52.4.2.48.68 1.66.74 1.78.06.12.1.27.02.43-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.24.24-.1.47.14.23.62 1.02 1.33 1.65.91.81 1.68 1.06 1.92 1.18.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.18 1.26z"
      />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      class={className}
      fill={filled && name === 'star' ? 'currentColor' : 'none'}
      stroke="currentColor"
      stroke-width={name === 'star' ? 1.25 : 1.5}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={paths[name]}
    />
  )
}
