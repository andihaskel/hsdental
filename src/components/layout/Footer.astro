---
import { site } from '../../data/site';

const links = [
  { label: 'Tratamientos', href: '#tratamientos' },
  { label: 'Equipo', href: '#equipo' },
  { label: 'Reseñas', href: '#resenas' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer class="bg-paper text-ink">
  <div class="site-container flex flex-col gap-10 py-14 lg:flex-row lg:items-end lg:justify-between lg:py-16">
    <div>
      <p class="text-[0.8rem] font-medium tracking-[0.2em]">HASKEL SOCOLOVSKY</p>
      <p class="mt-1 text-[0.58rem] tracking-[0.28em] text-muted">ODONTOLOGÍA</p>
      <nav aria-label="Pie de página" class="mt-6">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]">
          {links.map((item) => (
            <li><a href={item.href} class="hover:opacity-60">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col items-start gap-4">
      <a href="#consulta" class="btn btn-solid">Agendar consulta</a>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <li>
          <a class="underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a class="hover:opacity-60" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
            Instagram {site.instagram.handle}
          </a>
        </li>
        <li>
          <a class="underline underline-offset-4" href={site.maps.search} target="_blank" rel="noopener noreferrer">
            Google Maps
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line-strong/80">
    <div class="site-container py-5 text-xs text-muted">
      <p>© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
