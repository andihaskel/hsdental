---
import { nav } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-white">
  <div class="site-container flex h-16 items-center justify-between gap-6 lg:h-[4.5rem]">
    <a href="/" class="leading-none">
      <span class="block text-[0.72rem] font-medium tracking-[0.2em] sm:text-[0.8rem]">HASKEL SOCOLOVSKY</span>
      <span class="mt-1 block text-[0.58rem] tracking-[0.28em] text-muted">ODONTOLOGÍA</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} class="text-[0.92rem] text-ink hover:opacity-60">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="#consulta" class="btn btn-solid hidden lg:inline-flex">Agendar consulta</a>

    <button
      id="menu-open"
      type="button"
      class="inline-flex size-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú"
    >
      <Icon name="menu" class="size-6" />
    </button>
  </div>
</header>

<dialog id="mobile-nav" class="m-0 h-full max-h-none w-full max-w-none border-0 bg-white p-0" aria-label="Menú">
  <div class="flex h-full flex-col">
    <div class="site-container flex h-16 items-center justify-between border-b border-line">
      <a href="/" class="leading-none" data-close-nav>
        <span class="block text-[0.72rem] font-medium tracking-[0.2em]">HASKEL SOCOLOVSKY</span>
        <span class="mt-1 block text-[0.58rem] tracking-[0.28em] text-muted">ODONTOLOGÍA</span>
      </a>
      <button id="menu-close" type="button" class="inline-flex size-11 items-center justify-center" aria-label="Cerrar menú">
        <Icon name="close" class="size-6" />
      </button>
    </div>
    <nav class="site-container flex flex-col py-8" aria-label="Móvil">
      {
        nav.map((item) => (
          <a href={item.href} data-close-nav class="border-b border-line py-4 text-2xl font-medium tracking-tight">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="site-container mt-auto pb-10">
      <a href="#consulta" data-close-nav class="btn btn-solid w-full">Agendar consulta →</a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-nav');
  const openButton = document.querySelector<HTMLButtonElement>('#menu-open');
  const closeButton = document.querySelector<HTMLButtonElement>('#menu-close');

  const setOpen = (open: boolean) => {
    openButton?.setAttribute('aria-expanded', String(open));
  };

  openButton?.addEventListener('click', () => {
    dialog?.showModal();
    setOpen(true);
  });

  closeButton?.addEventListener('click', () => {
    dialog?.close();
    setOpen(false);
  });

  dialog?.addEventListener('close', () => setOpen(false));

  dialog?.querySelectorAll('[data-close-nav]').forEach((link) => {
    link.addEventListener('click', () => dialog.close());
  });
</script>
