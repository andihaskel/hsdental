---
import { consultationReasons, timePreferences } from '../../data/site';

const endpoint = import.meta.env.PUBLIC_CONSULTATION_ENDPOINT ?? '';
---

<form
  id="consultation-form"
  class="border border-white/15 p-5 sm:p-7"
  novalidate
  data-endpoint={endpoint}
>
  <h3 class="text-base font-medium">Solicitud de consulta</h3>

  <div id="form-status" class="mt-4 hidden text-sm leading-relaxed" role="status" aria-live="polite"></div>
  <p id="form-fallback" class="mt-3 hidden text-sm">
    <a id="form-whatsapp" class="underline underline-offset-4" href="https://wa.me/59892077745" target="_blank" rel="noopener noreferrer">
      Enviar la solicitud por WhatsApp →
    </a>
  </p>

  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    <div data-field="name">
      <label class="field-label" for="consult-name">Nombre y apellido</label>
      <input class="field-control" id="consult-name" name="name" type="text" autocomplete="name" required />
      <p class="field-error hidden" id="error-name"></p>
    </div>
    <div data-field="phone">
      <label class="field-label" for="consult-phone">Teléfono</label>
      <input class="field-control" id="consult-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
      <p class="field-error hidden" id="error-phone"></p>
    </div>
    <div data-field="email">
      <label class="field-label" for="consult-email">Correo electrónico (opcional)</label>
      <input class="field-control" id="consult-email" name="email" type="email" autocomplete="email" />
      <p class="field-error hidden" id="error-email"></p>
    </div>
    <div data-field="reason" class="relative">
      <label class="field-label" for="consult-reason">Motivo de la consulta</label>
      <select class="field-control appearance-none pr-8" id="consult-reason" name="reason" required>
        {consultationReasons.map((reason) => <option value={reason}>{reason}</option>)}
      </select>
      <svg class="pointer-events-none absolute bottom-3 right-0 size-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
      <p class="field-error hidden" id="error-reason"></p>
    </div>
    <div data-field="timePreference" class="relative">
      <label class="field-label" for="consult-time">Preferencia horaria</label>
      <select class="field-control appearance-none pr-8" id="consult-time" name="timePreference" required>
        {timePreferences.map((preference) => <option value={preference}>{preference}</option>)}
      </select>
      <svg class="pointer-events-none absolute bottom-3 right-0 size-4 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
      <p class="field-error hidden" id="error-timePreference"></p>
    </div>
    <div data-field="comments">
      <label class="field-label" for="consult-comments">Comentarios (opcional)</label>
      <input class="field-control" id="consult-comments" name="comments" type="text" maxlength="500" />
      <p class="field-error hidden" id="error-comments"></p>
    </div>
  </div>

  <div class="mt-6" data-field="consent">
    <label class="flex items-start gap-3 text-sm leading-snug" for="consult-consent">
      <input class="check" id="consult-consent" name="consent" type="checkbox" value="yes" />
      <span>Acepto que la clínica me contacte para coordinar la consulta.</span>
    </label>
    <p class="field-error hidden" id="error-consent"></p>
  </div>

  <button id="consult-submit" class="btn btn-light mt-6" type="submit">
    Enviar solicitud →
  </button>
  <p class="mt-4 max-w-sm text-xs leading-relaxed text-white/55">
    El envío no confirma un turno: la clínica se comunicará para coordinar día y hora.
  </p>
</form>

<script>
  import { submitConsultation, whatsappConsultationUrl } from '../../utils/consultation';
  import { toPayload, validateConsultation, type ConsultationInput, type FieldName } from '../../utils/validation';

  const form = document.querySelector<HTMLFormElement>('#consultation-form');
  if (form) {
    const status = document.querySelector<HTMLElement>('#form-status');
    const fallback = document.querySelector<HTMLElement>('#form-fallback');
    const whatsapp = document.querySelector<HTMLAnchorElement>('#form-whatsapp');
    const submitButton = document.querySelector<HTMLButtonElement>('#consult-submit');
    const fields: FieldName[] = ['name', 'phone', 'email', 'reason', 'timePreference', 'comments', 'consent'];

    const readInput = (): ConsultationInput => {
      const data = new FormData(form);
      return {
        name: String(data.get('name') ?? ''),
        phone: String(data.get('phone') ?? ''),
        email: String(data.get('email') ?? ''),
        reason: String(data.get('reason') ?? ''),
        timePreference: String(data.get('timePreference') ?? ''),
        comments: String(data.get('comments') ?? ''),
        consent: data.get('consent') === 'yes',
      };
    };

    const clearErrors = () => {
      fields.forEach((field) => {
        const wrapper = form.querySelector<HTMLElement>(`[data-field="${field}"]`);
        const message = document.querySelector<HTMLElement>(`#error-${field}`);
        const control = wrapper?.querySelector<HTMLElement>('input, select');
        wrapper?.removeAttribute('data-invalid');
        control?.removeAttribute('aria-invalid');
        control?.removeAttribute('aria-describedby');
        if (message) {
          message.textContent = '';
          message.classList.add('hidden');
        }
      });
    };

    const showErrors = (errors: Partial<Record<FieldName, string>>) => {
      (Object.keys(errors) as FieldName[]).forEach((field) => {
        const wrapper = form.querySelector<HTMLElement>(`[data-field="${field}"]`);
        const message = document.querySelector<HTMLElement>(`#error-${field}`);
        const control = wrapper?.querySelector<HTMLElement>('input, select');
        wrapper?.setAttribute('data-invalid', 'true');
        control?.setAttribute('aria-invalid', 'true');
        control?.setAttribute('aria-describedby', `error-${field}`);
        if (message) {
          message.textContent = errors[field] ?? '';
          message.classList.remove('hidden');
        }
      });
      const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
      first?.focus();
    };

    const showStatus = (message: string, kind: 'ok' | 'error') => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden');
      status.classList.toggle('text-danger', kind === 'error');
      status.classList.toggle('text-white', kind === 'ok');
    };

    const applyReason = (reason: string | null) => {
      if (!reason) return;
      const select = form.querySelector<HTMLSelectElement>('#consult-reason');
      if (!select) return;
      const match = Array.from(select.options).some((option) => option.value === reason);
      if (match) select.value = reason;
    };

    applyReason(new URLSearchParams(window.location.search).get('motivo'));

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest<HTMLAnchorElement>('[data-consultation-reason]');
      if (!link) return;
      event.preventDefault();
      const reason = link.dataset.consultationReason ?? null;
      applyReason(reason);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelector('#consulta')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      if (reason) {
        const url = new URL(window.location.href);
        url.searchParams.set('motivo', reason);
        url.hash = 'consulta';
        history.replaceState(null, '', url);
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.submitting === 'true') return;

      clearErrors();
      fallback?.classList.add('hidden');
      status?.classList.add('hidden');

      const input = readInput();
      const errors = validateConsultation(input);
      if (Object.keys(errors).length > 0) {
        showErrors(errors);
        showStatus('Revise los campos indicados para enviar la solicitud.', 'error');
        return;
      }

      const payload = toPayload(input);
      if (!payload || !submitButton) return;

      form.dataset.submitting = 'true';
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      submitButton.textContent = 'Enviando…';

      const result = await submitConsultation(payload, form.dataset.endpoint ?? '');

      form.dataset.submitting = 'false';
      submitButton.removeAttribute('aria-busy');

      if (result.ok) {
        submitButton.textContent = 'Solicitud enviada';
        showStatus(
          'Recibimos su solicitud. La clínica se comunicará para confirmar día y hora. El envío no confirma un turno.',
          'ok',
        );
        return;
      }

      submitButton.disabled = false;
      submitButton.textContent = 'Enviar solicitud →';

      if (result.reason === 'unconfigured') {
        if (whatsapp) whatsapp.href = whatsappConsultationUrl(payload);
        fallback?.classList.remove('hidden');
        showStatus(
          'El formulario en línea todavía no está conectado, así que la solicitud no se envió. Puede mandarla por WhatsApp o llamar a la clínica.',
          'error',
        );
        return;
      }

      showStatus('No pudimos enviar la solicitud. Inténtelo de nuevo o escriba por WhatsApp.', 'error');
    });
  }
</script>
