---
import { Image } from 'astro:assets';
import { team } from '../../data/team';
import carlos from '../../assets/images/carlos-haskel.jpg';
import beatriz from '../../assets/images/beatriz-socolovsky.jpg';
import denise from '../../assets/images/denise-haskel.jpg';
import adriana from '../../assets/images/adriana-gaspar.jpg';
import stephanie from '../../assets/images/stephanie-ramos.jpg';
import ramiro from '../../assets/images/ramiro-betancor.jpg';

const portraits = {
  'carlos-haskel': carlos,
  'beatriz-socolovsky': beatriz,
  'denise-haskel': denise,
  'adriana-gaspar': adriana,
  'stephanie-ramos': stephanie,
  'ramiro-betancor': ramiro,
} as const;
---

<section id="equipo" class="scroll-mt-20 bg-white" aria-labelledby="equipo-title">
  <div class="site-container py-20 lg:py-28">
    <div>
      <p class="eyebrow">04 — Equipo profesional</p>
      <h2 id="equipo-title" class="section-title mt-4">
        Profesionales con formación<br />
        <span class="text-soft">especializada.</span>
      </h2>
    </div>

    <ul class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {
        team.map((person, index) => (
          <li class:list={[index % 3 === 1 && 'lg:mt-24']}>
            <article>
              <figure class="relative aspect-[4/5] overflow-hidden bg-ink">
                <Image
                  src={portraits[person.id as keyof typeof portraits]}
                  alt={`Retrato de ${person.name}`}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 28vw, (min-width: 768px) 45vw, 100vw"
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover object-center"
                />
              </figure>
              <div class="mt-4 border-t border-line-strong pt-4">
                <p class="text-[0.68rem] font-medium uppercase tracking-[0.14em] text-muted">{person.specialty}</p>
                <h3 class="mt-2 text-xl font-semibold tracking-tight">{person.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-body">{person.biography}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
