---
import { treatments } from '../../data/treatments';
---

<section id="tratamientos" class="scroll-mt-20 bg-white" aria-labelledby="tratamientos-title">
  <div class="site-container py-20 lg:py-28">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,0.7fr)] lg:items-start lg:gap-x-10">
      <div>
        <p class="eyebrow">02 — Tratamientos</p>
        <h2 id="tratamientos-title" class="section-title mt-4">
          Tratamientos y<br class="lg:hidden" /> especialidades.
        </h2>
      </div>
      <p class="text-sm leading-relaxed text-muted lg:pt-9">
        Cuando un caso requiere más de una especialidad, el equipo elabora un plan conjunto con un único profesional de referencia.
      </p>
    </div>

    <div class="mt-14 border-t border-line-strong">
      <ul class="grid md:grid-cols-2 lg:grid-cols-3">
        {
          treatments.map((treatment) => (
            <li id={treatment.id} class="scroll-mt-24 border-b border-line-strong py-7 pr-6">
              <div class="flex items-baseline gap-4">
                <span class="text-xs text-muted">{treatment.number}</span>
                <h3 class="text-[1.15rem] font-semibold tracking-tight">{treatment.name}</h3>
              </div>
              <p class="mt-3 pl-8 text-sm leading-relaxed text-body">{treatment.description}</p>
              <a class="text-link mt-5 inline-flex pl-8 text-sm" href="#consulta">
                Ver tratamiento →
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-6 bg-slate px-6 py-8 text-ink sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-10 lg:py-9">
      <div>
        <p class="text-lg font-medium tracking-tight">¿No está seguro de qué tratamiento necesita?</p>
        <p class="mt-2 text-sm leading-relaxed">
          En la primera consulta evaluamos su caso y le explicamos las alternativas disponibles.
        </p>
      </div>
      <a href="#consulta" class="btn btn-solid shrink-0">Agendar consulta →</a>
    </div>
  </div>
</section>
