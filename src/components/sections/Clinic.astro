---
import { site } from '../../data/site';
import PendingBadge from '../ui/PendingBadge.astro';

const years = site.yearsOfExperience === null ? '[—]' : String(site.yearsOfExperience);

const stats = [
  { value: '6', label: 'especialistas' },
  { value: '9', label: 'especialidades' },
  { value: years, label: 'años de trayectoria', pending: site.yearsOfExperience === null },
  { value: '1', label: 'plan coordinado por paciente' },
];
---

<section id="clinica" class="scroll-mt-20 bg-paper" aria-labelledby="clinica-title">
  <div class="site-container grid gap-10 py-20 lg:grid-cols-2 lg:gap-x-20 lg:py-28">
    <div>
      <p class="eyebrow">01 — La clínica</p>
      <h2 id="clinica-title" class="section-title mt-4">
        Un equipo de<br />especialistas con un<br />criterio común.
      </h2>
    </div>
    <div class="lg:pt-8">
      <p class="text-[1.05rem] leading-relaxed">
        Haskel Socolovsky Odontología reúne a profesionales de distintas especialidades que trabajan de manera coordinada. Cada tratamiento se basa en la evidencia científica y se planifica en función de las necesidades de cada paciente.
      </p>
      <p class="mt-6 text-sm leading-relaxed text-body">
        Entendemos que un resultado estable depende de la suma de pasos bien realizados. Por eso dedicamos el tiempo necesario al diagnóstico, explicamos cada alternativa y cuidamos cada detalle del proceso.
      </p>
      <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-line-strong pt-8 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div>
              <dt class="text-[2.4rem] font-medium leading-none tracking-tight">{stat.value}</dt>
              <dd class="mt-3 text-sm leading-snug text-muted">{stat.label}</dd>
              {stat.pending ? <PendingBadge class="mt-3">A completar</PendingBadge> : null}
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
