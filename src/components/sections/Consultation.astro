---
import { site } from '../../data/site';
---

<section id="consulta" class="on-dark scroll-mt-20 bg-ink text-white" aria-labelledby="consulta-title">
  <div class="site-container grid gap-12 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div>
      <p class="eyebrow text-white/55">06 — Agendar consulta</p>
      <h2 id="consulta-title" class="mt-5 text-[clamp(2.6rem,4.4vw,4.3rem)] font-medium leading-[0.98] tracking-[-0.035em]">
        Coordine su<br />primera<br />
        <span class="text-soft-dark">consulta.</span>
      </h2>
    </div>

    <div class="flex flex-col justify-between border border-white/15 p-5 sm:p-7">
      <div>
        <h3 class="text-base font-medium">Reserva de horas</h3>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/75">
          La agenda online de la clínica permite elegir día y horario. Si prefiere, también puede escribir por WhatsApp.
        </p>
      </div>
      <div class="mt-8">
        <a class="btn btn-light" href={site.booking.href} target="_blank" rel="noopener noreferrer">
          Reservar hora →
        </a>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-white/55">
          La reserva no confirma el turno por sí sola: la clínica lo valida en la agenda.
        </p>
      </div>
    </div>
  </div>
</section>
