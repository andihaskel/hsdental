---
import { site } from '../../data/site';
---

<section id="contacto" class="scroll-mt-20 bg-white" aria-labelledby="contacto-title">
  <div class="site-container grid gap-10 py-20 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div>
      <p class="eyebrow">07 — Contacto y ubicación</p>
      <h2 id="contacto-title" class="section-title mt-4">
        {site.address.street},<br />{site.address.city}.
      </h2>

      <div class="mt-8 border-t border-line-strong pt-6">
        <div class="grid grid-cols-2 gap-6">
          <div>
            <p class="text-xs text-muted">Horario</p>
            <p class="mt-2 text-sm font-medium">{site.hours.summary}</p>
          </div>
          <div>
            <p class="text-xs text-muted">Teléfonos</p>
            <p class="mt-2 text-sm font-medium">
              <a class="underline underline-offset-4" href={site.phones[0].href}>{site.phones[0].display}</a>
              <span aria-hidden="true"> · </span>
              <a class="underline underline-offset-4" href={site.phones[1].href}>{site.phones[1].display}</a>
            </p>
          </div>
          <div>
            <p class="text-xs text-muted">WhatsApp</p>
            <p class="mt-2 text-sm font-medium">
              <a class="underline underline-offset-4" href={site.whatsapp.href} target="_blank" rel="noopener noreferrer">
                {site.whatsapp.display}
              </a>
            </p>
          </div>
          <div>
            <p class="text-xs text-muted">Correo</p>
            <p class="mt-2 text-sm font-medium">
              <a class="underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <a class="btn btn-solid" href={site.maps.directions} target="_blank" rel="noopener noreferrer">Cómo llegar →</a>
        <a class="text-link text-sm" href={site.maps.search} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
      </div>
    </div>

    <div class="min-h-80 bg-mist lg:min-h-full">
      <iframe
        title="Mapa de Haskel Socolovsky Odontología, Av. Sarmiento 2553, Montevideo"
        src={site.maps.embed}
        class="h-full min-h-80 w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
