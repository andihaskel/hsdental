---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import cartel from '../../assets/images/cartel-sol.jpg';
---

<section class="bg-white" aria-labelledby="hero-title">
  <div class="site-container grid items-stretch gap-10 pb-16 pt-10 lg:grid-cols-2 lg:gap-12 lg:pb-24 lg:pt-16">
    <div class="flex flex-col">
      <p class="eyebrow">Clínica odontológica en Montevideo</p>
      <h1 id="hero-title" class="display mt-5">
        Odontología<br />integral con un<br />enfoque<br />personalizado.
      </h1>
      <p class="mt-8 max-w-md text-[1.05rem] leading-relaxed text-body">
        Con más de 40 años de recorrido, combinamos experiencia profesional, tecnología y atención individualizada para acompañar cada etapa de su tratamiento.
      </p>
      <div class="mt-8 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <a href="#consulta" class="btn btn-solid">Agendar consulta →</a>
        <a href="#tratamientos" class="text-link">Conozca nuestros tratamientos</a>
      </div>
    </div>

    <Image
      src={cartel}
      alt={`Cartel de ${site.name} sobre la fachada`}
      width={819}
      height={1024}
      widths={[480, 640, 819]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full bg-slate-light"
    />
  </div>
</section>
